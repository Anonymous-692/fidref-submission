{
  "description": "Five-seed price-aware Shopping pilot, unconstrained JSON generation. guided_json 을 끈 조건. vLLM 0.8.5 outlines 백엔드가 본 도메인의 JSON 스키마 FSM 컴파일에서 정지(GPU 0%, 워커 CPU 77%, 6분간 토큰 0)하여 구조화 디코딩 없이 측정한다.",
  "domain": "shopping_price",
  "sandbox_config": "experiment/configs/shopping_price_default.json",
  "base_url": "http://127.0.0.1:8000/v1",
  "model": "qwen2.5-14b-instruct",
  "methods": [
    "direct",
    "active_cegis"
  ],
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "temperature": 0.2,
  "top_p": 0.95,
  "max_tokens": 2048,
  "state_budget": 48,
  "query_budget": 4,
  "token_budget": 16000,
  "max_depth": 20,
  "max_states": 15000,
  "timeout": 600.0,
  "workers": 1,
  "compact_context": true,
  "context_token_limit": 8192,
  "context_margin": 256,
  "counterexample_limit": 3,
  "refinement_protocol": "self_contained_v3",
  "guided_json": false
}
